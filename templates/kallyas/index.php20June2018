<script>

	jQuery(function() {
		checkSliderSize();
		jQuery(window).on('resize', function() {
			checkSliderSize();
		});
	});

	function showSlidebar(id) {
		var $slidebar = jQuery('#' + id);

		if($slidebar.length) {
			if(!$slidebar.hasClass('is-open')) {
				if($slidebar.hasClass('slidebar-left')) {
					$slidebar.css({ left: 0 }, 300);
				}
				else if($slidebar.hasClass('slidebar-right')) {
					$slidebar.css({ right: 0 }, 300);
				}

				$slidebar.addClass('is-open');
			}
			else {
				hideSlidebar(id);
			}
		}

		return false;
	}

	function hideSlidebar(id) {
		var $slidebar = jQuery('#' + id);

		if($slidebar.length) {
			if(jQuery(window).width() > 767) {
				if($slidebar.hasClass('slidebar-left')) {
					$slidebar.css({ left: '-55%' }, 300);
				}
				else if($slidebar.hasClass('slidebar-right')) {
					
					$slidebar.css({ right: '-55%' }, 300);
				}
			}
			else {
				if($slidebar.hasClass('slidebar-left')) {
					$slidebar.css({ left: '-100%' }, 300);
				}
				else if($slidebar.hasClass('slidebar-right')) {
					
					$slidebar.css({ right: '-100%' }, 300);
				}
			}

			$slidebar.removeClass('is-open');
		}

		return false;
	}

	function checkSliderSize() {
		jQuery('.slidebar').each(function(index, slidebar) {
			var $slidebar = jQuery(slidebar),
				$slidebarContent = $slidebar.find('.slidebar-content');

			$slidebarContent.height(jQuery(window).height() - 43);
			$slidebarContent.find('.slidebar-content-iframe').height(jQuery(window).height() - 50);
		});
	}

</script>
