    function contact_us(){
		$app = JFactory::getApplication();
		$post = JRequest::get('post');
		$CORRECT_SUBJECT = htmlentities($post["rp_subject"], ENT_COMPAT, "UTF-8");
		$CORRECT_MESSAGE = htmlentities($post["rp_message"], ENT_COMPAT, "UTF-8");
		// check email
		if ($post["rp_email"] === "") {
			$app->redirect('index.php?option=com_survey&task=customer.expertProfile&display='.$post['form_usage'],'Please enter email address','error');
		}
		if (!preg_match("/^[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$/", strtolower($post["rp_email"]))) {
			$app->redirect('index.php?option=com_survey&task=customer.expertProfile&display='.$post['form_usage'],'Please enter correct email address','error');
		} else {
			$CORRECT_EMAIL = htmlentities($post["rp_email"], ENT_COMPAT, "UTF-8");
		}

		$mySubject = $post["rp_subject"];
		$myMessage = 'You received a message from '. $post["rp_email"] ."\n\n". $post["rp_message"];
		$mailSender = JFactory::getMailer();
		$mailSender->addRecipient($recipient);
		$mailSender->setSender(array($fromEmail,$fromName));
		$mailSender->addReplyTo(array( $post["rp_email"], '' ));
		$mailSender->setSubject($mySubject);
		$mailSender->setBody($myMessage);
		if ($mailSender->Send() !== true) {
			$app->redirect('index.php?option=com_survey&task=customer.expertProfile&display='.$post['form_usage'],'Please try after sometime','error');
		}
		else {
			$app->redirect('index.php?option=com_survey&task=customer.expertProfile&display='.$post['form_usage'],'Email send to expert','success');
		}
	}

