    function quListExpert()
    {
        $quParam = JRequest::getVar('ps', '');
        $expertID = JRequest::getInt('f');
        if (!empty($quParam)) {
            $getList = $this->getModel()->quListExpert($quParam, $expertID);
            echo json_encode($getList);
