	function sendAlert(){
		$p = JRequest::getVar('p', '0');
		$t = JRequest::getVar('t', '');
		$email = JRequest::getVar('e', '');
		$c = JRequest::getVar('c', '0');
		$saveData = $this->getModel()->saveEmailAlert(array('project_id'=>$p,'email_address'=>$email,'survey_id'=>$c));
		echo $saveData;
	}
	
	
