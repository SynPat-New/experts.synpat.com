    function projectSurveyQuestion()
    {
        $data = JRequest::get('post');
        $checkData = $this->getModel()->checkProjectWithName($data['p']);
        if (count($checkData) == 0) {
            $project = array('name' => $data['p'], 'exclusive' => $data['e']);
            $projectID = $this->getModel('Project')->save($project);
            if ($projectID > 0) {
                $survey = array('name' => $data['s'], 'project_id' => $projectID);
                $surveyID = $this->getModel('Survey')->save($survey);
                if ($surveyID > 0) {
                    $description = ($data['q'] != "") ? $data['q'] : '1';
                    $question = array('description' => $description, 'survey_id' => $surveyID);
                    $questionID = $this->getModel('Question')->save($question);
                    if ($questionID > 0) {
                        /*Now enter the data to transaction table for order*/
                        $type = 1; // For Order
                        $amount = 500;
                        $transactionID = $this->getModel()->insertTrans($amount, $surveyID, 0, $type);
                        echo json_encode(array('error' => '', 'id' => $transactionID));
                        /*End enter transaction*/
                    } else {
                        /* Delete Project and Survey*/
                        $this->getModel('Project')->delete($projectID);
                        $this->getModel('Survey')->delete($surveyID);
                        echo json_encode(array('error' => 'Project not saved, Please try after sometime.', 'id' => 0));
                    }
                } else {
                    /*Delete Save Project*/
                    $this->getModel('Project')->delete($projectID);
                    echo json_encode(array('error' => 'Project not saved, Please try after sometime.', 'id' => 0));
                }
            } else {
                echo json_encode(array('error' => 'Project not saved, Please try after sometime.', 'id' => 0));
            }
        } else {
            echo json_encode(array('error' => 'Project name already used.', 'id' => 0));
        }
    }


    function projectSurveyQuestionMultiple()
    {
		/*
       $user = JFactory::getUser();
       $app = JFactory::getApplication();
       if($user->id==0){
			$app->redirect(JRoute::_('index.php/order'),"Please login first","error");
	   } */      
       /*Saving Multiple Project Data*/
       $app = JFactory::getApplication();
       $data = JRequest::get('post');
	   $projectName = $data['project_name_multiple'];
	   $projectDeadLine = $data['project_deadline_multiple'];
	    if($projectName!=""){
			$checkData = $this->getModel()->checkProjectWithName($projectName);
			if (count($checkData) == 0) {
			   /*Saving Project Data*/
				$project = array('name' => $projectName);
				$projectID = $this->getModel('Project')->save($project);
				if($projectID > 0) {
					$countNumberPatent = 0;
					$claimExclusive = 0;
					$claimNonExclusive = 0;
					$priorExclusive = 0;
					$priorNonExclusive = 0;
					$flag = 0;
					for($i=0;$i<count($data['type_of_report']);$i++){
						if($data['type_of_report'][$i]!='0' && $data['type_of_document'][$i]!='0' && $data['type_of_exclusivity'][$i]!='0'){
							$survey = array();
							switch((int)$data['type_of_report'][$i]){
								case 1:
									/*Prior Art*/
									switch((int)$data['type_of_document'][$i]){
										case 1:
											/*Patent*/
											$combineName="US".$data['patent'.$i]."(".$data['claim'.$i].")";
											$survey = array('name' => $data['patent'.$i], 'project_id' => $projectID, 'combine_name' => $combineName, 'exclude' => $data['type_of_exclusivity'][$i],'document_type'=>(int)$data['type_of_document'][$i],'report_type'=>(int)$data['type_of_report'][$i],'comment' => $data['comment'],'deadline' => $data['project_deadline_multiple'],'maximum_price_claim'=>$data['maximum_price_claim'],'specific_expert'=>$data['specific_expert'],'minimum_price_claim'=>$data['minimum_price_claim'.$i],'email_sms'=>$data['email_sms']);
										break;
										case 2:
											/*Published: Save Application Number in Patent Field*/
											$survey = array('name' => $data['application'.$i], 'project_id' => $projectID, 'combine_name' => $data['claim'.$i], 'exclude' => $data['type_of_exclusivity'][$i],'document_type'=>(int)$data['type_of_document'][$i],'report_type'=>(int)$data['type_of_report'][$i],'comment' => $data['comment'],'deadline' => $data['project_deadline_multiple'],'maximum_price_claim'=>$data['maximum_price_claim'],'specific_expert'=>$data['specific_expert'],'published_date' => $data['published_date'.$i],'minimum_price_claim'=>$data['minimum_price_claim'.$i],'email_sms'=>$data['email_sms']);
										break;
										case 3:
											/*Unpublished*/
											$survey = array('project_id' => $projectID,'exclude' => $data['type_of_exclusivity'][$i],'description'=>$data['claim_language'.$i],'document_type'=>(int)$data['type_of_document'][$i],'report_type'=>(int)$data['type_of_report'][$i],'comment' => $data['comment'],'deadline' => $data['project_deadline_multiple'],'maximum_price_claim'=>$data['maximum_price_claim'],'specific_expert'=>$data['specific_expert'],'published_date' => $data['published_date'.$i],'minimum_price_claim'=>$data['minimum_price_claim'.$i],'email_sms'=>$data['email_sms']);
										break;
									}
								break;
								case 2:
									/*Claimchart*/
									switch((int)$data['type_of_document'][$i]){
										case 1:
											/*Patent*/
											$combineName="US".$data['patent'.$i]."(".$data['claim'.$i].")";
											$survey = array('name' => $data['patent'.$i], 'project_id' => $projectID, 'combine_name' => $combineName, 'exclude' => $data['type_of_exclusivity'][$i],'document_type'=>(int)$data['type_of_document'][$i],'report_type'=>(int)$data['type_of_report'][$i],'comment' => $data['comment'],'target' => $data['target'.$i],'avoided' => $data['avoided'.$i],'deadline' => $data['project_deadline_multiple'],'maximum_price_claim'=>$data['maximum_price_claim'],'specific_expert'=>$data['specific_expert'],'minimum_price_claim'=>$data['minimum_price_claim'.$i],'email_sms'=>$data['email_sms']);
										break;								
									}
								break;
							}						
							$surveyID = 0;
							if(count($survey)>0){
								$surveyID = $this->getModel('Survey')->save($survey);
							}						
							$flag = 0;
							if ($surveyID > 0) {
								switch((int)$data['type_of_report'][$i]){
									case 1:
										/*Prior Art*/
										switch((int) $data['type_of_exclusivity'][$i]){
											case 1:
												/*Exclusive*/
												$priorExclusive = $priorExclusive + 1;
											break;
											case 2:
												/*Non Exclusive*/
												$priorNonExclusive = $priorNonExclusive + 1;
											break;
										}
									break;
									case 2:
										/*ClaimChart*/
										switch((int) $data['type_of_exclusivity'][$i]){
											case 1:
												/*Exclusive*/
												$claimExclusive = $claimExclusive + 1;
											break;
											case 2:
												/*Non Exclusive*/
												$claimNonExclusive = $claimNonExclusive + 1;
											break;
										}
									break;
								}
							} else {
								$flag = 1;
							}
							if ($flag == 0) {
								$countNumberPatent++;
							}
						}
					}
					if ($countNumberPatent > 0 && $flag == 0) {
						$type = 1; // For Order
						$claimExclusiveAmount = 700;
						$claimNonExclusiveAmount = 400;
						$priorExclusiveAmount = 900;
						$priorNonExclusiveAmount = 700;
						$total = 0;
						$total = $total + $claimExclusive * $claimExclusiveAmount;
						$total = $total + $claimNonExclusive * $claimNonExclusiveAmount;
						$total = $total + $priorNonExclusive * $priorNonExclusiveAmount;
						$total = $total + $priorExclusive * $priorExclusiveAmount;
						/*Saving Transaction*/
						$transactionID = $this->getModel()->insertTrans($total, $projectID, 0, $type);
						if($transactionID>0){
							$db = JFactory::getDBO();
							$sql = "SELECT * FROM #__paypal_setting";
							$db->setQuery($sql);
							$getPaypalData = $db->loadObject();
							$paypalEmail = $getPaypalData->email_id;
							$paypalURL = "";
							if ($getPaypalData->mode == 1) {
								$paypalURL = "https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&notify_version=2.9";
							} else {
								$paypalURL = "https://www.sandbox.paypal.com/cgi-bin/webscr?cmd=_xclick&notify_version=2.9";
							}
							if(!empty($paypalURL)){
								/*$paypalURL = $paypalURL."&business=".$paypalEmail."&lc=US&item_name=Order Of ClaimCharts&desc=Payment for the Orders&quantity=".$countNumberPatent. "&amount=" .$total. "&currency_code=USD&item_number=" .$transactionID. "&notify_url=".urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderNotify&raw='.$transactionID)."&return=".urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderSuccess&raw='.$transactionID)."&cancel=".urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderCancel&raw=').$transactionID;*/
								$paypalURL = $paypalURL."&business=".$paypalEmail."&lc=US&item_name=Order Of ClaimCharts&desc=Payment for the Orders&quantity=1&amount=" .$total. "&currency_code=USD&item_number=" .$transactionID. "&notify_url=".urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderNotify&raw='.$transactionID)."&return=".urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderSuccess&raw='.$transactionID)."&cancel=".urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderCancel&raw=').$transactionID;
								$app->redirect($paypalURL);
							} else {
								$this->getModel('Project')->delete($projectID);
								$app->redirect('index.php/order','Please try after sometime.','error');
							}
						} else {
							$this->getModel('Project')->delete($projectID);
							$app->redirect('index.php/order','Please try after sometime.','error');
						}
					} else {
						$this->getModel('Project')->delete($projectID);
						$app->redirect('index.php/order','Please try after sometime.','error');
					}
				}
		    } else {
			   $app->redirect('index.php/order','Please try different project name.','error');
		    }
	    } else {
			$app->redirect('index.php/order','Please enter project name.','error');
		}		
       /*End Saving*/
    }

    function search()
    {
        $data = JRequest::get('post');
        if ($data['p'] != "") {
            $getList = $this->getModel()->checkProjectWithName($data['p']);
            echo json_encode(array('data' => $getList));
        } else if ($data['s'] != "") {
            $getList = $this->getModel()->checkProjectWithSurveyName($data['s']);
            echo json_encode(array('data' => $getList));
        } else if ($data['e'] != "") {
            $getList = $this->getModel()->checkProjectWithExpertName($data['e']);
            echo json_encode(array('data' => $getList));
        } else {
            echo json_encode(array('data' => array()));
        }
    }

    function expertClaim()
    {
        $pID = JRequest::getInt('p');
        $expertID = JRequest::getInt('f');
        $db = JFactory::getDBo();
        $sql = "SELECT s.* FROM #__question as q LEFT JOIN #__survey as s ON s.id = q.survey_id WHERE s.project_id = '" . $pID . "' AND q.id IN(SELECT ques_id FROM `#__survey_question_answer` as qa WHERE expert_id = '" . $expertID . "') GROUP BY s.id";
        $db->setQuery($sql);
        $getList = $db->loadObjectList();
        echo json_encode($getList);
    }

    function showExpertRating()
    {
        $data = JRequest::get('post');
        $getList = $this->getModel()->expertRatingData($data['expert_id']);
        echo json_encode(array("data" => $getList, "id" => $data['expert_id']));
    }
	
	function array_flatten($array) { 
		if (!is_array($array)) { 
			return FALSE; 
		} 
		$result = array(); 
		foreach ($array as $key => $value) { 
			if (is_array($value)) { 
			  $result = array_merge($result, $this->array_flatten($value)); 
			} 
			else { 
			  $result[$key] = $value; 
			} 
		} 
		return $result; 
	} 
	
    function updateAreaExpertise()
    {
        $data = JRequest::get('post');
        $app = JFactory::getApplication();       
		ini_set("safe_mode", false);
		ini_set("max_execution_time", 0);
		set_time_limit(0);
		/*echo "<pre>";
		print_r(ini_get_all());
		die;*/
        if (isset($data['parent_checked']) || isset($data['child_1']) || isset($data['child_2']) || isset($data['child_3']) || isset($data['child_4'])) {
            $deleteOldArea = $this->getModel()->deleteOldExpertArea($data['e']);
            if (isset($data['parent_checked'])) {
                $this->getModel()->insertExpertArea($data['e'], $data['parent_checked']);				
            }
            if (isset($data['child_1']) && count($data['child_1']) > 0) {
				$getSingleData = array();
                for ($i = 0; $i < count($data['child_1']); $i++) {
                    //$this->getModel()->insertExpertArea($data['e'], $data['child_1'][$i]);
					$getData = $this->getModel()->getExpertAreaFromParent($data['child_1'][$i]);
					$getSingleData[] = $this->array_flatten($getData);					
                }
				array_values($getSingleData);
				/*echo "<pre>";
				print_r($getSingleData);
				die;*/
				if(count($getSingleData)>0){
					foreach($getSingleData as $singleData){
						if(count($singleData)>0){							
							foreach($singleData as $value){
								$this->getModel()->insertExpertArea($data['e'], $value);
							}
						}
					}
				}
            }
            if (isset($data['child_2']) && count($data['child_2']) > 0) {
                $getSingleData = array();
				for ($i = 0; $i < count($data['child_2']); $i++) {
                   // $this->getModel()->insertExpertArea($data['e'], $data['child_2'][$i]);
					$getData = $this->getModel()->getExpertAreaFromParent($data['child_2'][$i]);
					$getSingleData[] = $this->array_flatten($getData);
                }
				array_values($getSingleData);
				if(count($getSingleData)>0){
					foreach($getSingleData as $singleData){
						if(count($singleData)>0){
							foreach($singleData as $value){
								$this->getModel()->insertExpertArea($data['e'], $value);
							}
						}
					}
				}
            }
            if (isset($data['child_3']) && count($data['child_3']) > 0) {
				$getSingleData = array();
                for ($i = 0; $i < count($data['child_3']); $i++) {
                    //$this->getModel()->insertExpertArea($data['e'], $data['child_3'][$i]);
					$getData = $this->getModel()->getExpertAreaFromParent($data['child_3'][$i]);
					$getSingleData[] = $this->array_flatten($getData);
                }
				array_values($getSingleData);
				if(count($getSingleData)>0){
					foreach($getSingleData as $singleData){
						if(count($singleData)>0){
							foreach($singleData as $value){
								$this->getModel()->insertExpertArea($data['e'], $value);
							}
						}
					}
				}
            }
            if (isset($data['child_4']) && count($data['child_4']) > 0) {
                for ($i = 0; $i < count($data['child_4']); $i++) {
                    $this->getModel()->insertExpertArea($data['e'], $data['child_4'][$i]);
                }
            }
            $app->redirect('index.php?option=com_survey&task=customer.expertProfile&display=' . $data['e'], 'Expert area updated successfully', 'Success');
        } else {
            $app->redirect('index.php?option=com_survey&task=customer.expertProfile&display=' . $data['e'], 'No expert area is been selected', 'notice');
        }
    }


    /*
     * updateDesc - Called when Expert Profile is Updated/Submitted.
     * Handles Rich Text Fields
     * Handles File/Profile Picture Upload
     */
    function updateDesc()
    {
        $data = JRequest::get('post');
		$meData = array();
		if(is_array($data['me']) && count($data['me'])>0){
			for($i=0;$i<count($data['me']) ;$i++){
				$meData[] = $data['me'][$i]['value'];
			}
		}
		$meData = implode(',',$meData);
		$aeData = array();
		if(is_array($data['ae']) && count($data['ae'])>0){
			for($i=0;$i<count($data['ae']) ;$i++){
				$aeData[] = $data['ae'][$i]['value'];
			}
		}
		$aeData = implode(',',$aeData);
       	$sgData = array();
		if(is_array($data['sg']) && count($data['sg'])>0){
			for($i=0;$i<count($data['sg']) ;$i++){
				$sgData[] = $data['sg'][$i]['value'];
			}
		}
		$sgData = implode(',',$sgData);
		$data['me'] = $meData;
		$data['ae'] = $aeData;
		$data['sg'] = $sgData;
        // Parse raw data from rich editor controls
        $data['expl'] = JRequest::getVar('expl', '', 'post', 'string', JREQUEST_ALLOWHTML);
        $update = $this->getModel()->updateExpertDesc($data);
        echo $update;
    }
    
    
    /*
     * Update Expert Big HTML Text
     * 
     * */
    
    function updateProfileUser(){
		$session = JFactory::getSession();
		$getSession = $session->get('expertSession', '');
		$app = JFactory::getApplication();
		if(is_object($getSession) && count($getSession) > 0){
			$user_description = JRequest::getVar('descriptionEditor', '', 'post', 'string', JREQUEST_ALLOWHTML);
			$update = $this->getModel()->updateProfileUser(array('expl'=>$user_description,'d'=>$getSession->id));
			if($update){
				$app->redirect('index.php?option=com_survey&task=customer.expertProfile&display=' . $getSession->id, 'Update data', 'success');
			} else {
				$app->redirect('index.php?option=com_survey&task=customer.expertProfile&display=' . $getSession->id, 'No expert area is been selected', 'notice');
			}
		} else {
			$app->redirect('index.php', 'Please login first', 'warning');
		}
	}
    
    /*
     * Method for uploading profile CV/Resume using AJAX
     * Returns json response.
     */
    function uploadProfileResume()
    {
        $result = false;
        
        // Get Expert's ID for filename
        $data = JRequest::get('post');
        $id = $data['profileId'];
        
        // Handle File Upload
        jimport('joomla.filesystem.file');
        jimport('joomla.filesystem.folder');
        $filename = $_FILES["profileResume"]['name'];
        $fileExtension = pathinfo($filename, PATHINFO_EXTENSION);
        $fileTempPath = $_FILES["profileResume"]['tmp_name'];
         $fileNewPath = $id .'_'. $filename.'_'.time().'.' . $fileExtension;
        $uploadPath = JPATH_SITE.DS.'media'.DS.'com_survey'.DS.'profile_resumes'.DS.$fileNewPath;
        
        if(JFile::upload($fileTempPath, $uploadPath)){
            $result = true;
        }
        
        // Return JSON Response to ajax caller.
        $response = array( 'status' => $result, 'filename' => $fileNewPath ); 
        echo json_encode($response);
        jexit(); // to only return json.
    }
    
    /*
     * Method for uploading profile image using AJAX
     * Returns json response.
     */
