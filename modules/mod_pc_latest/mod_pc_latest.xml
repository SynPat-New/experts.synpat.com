	<authorUrl>www.avistechnologies.com</authorUrl>
	<version>2.5.2</version>
	<description>Show lastest report on front end</description>
	<files>
		<filename module="mod_pc_latest">mod_pc_latest.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
    <folder>tmpl</folder>
	</files>
	<config>
		<fields name="params">
