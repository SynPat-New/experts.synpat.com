    <script>		
        __DataExcel1 = '';
        __SiteURL = '<?php echo JUri::base() ?>';
        __PPURLForA = '<?php echo $paypalURL; ?>&business=<?php echo $paypalEmail; ?>'; 
       
		function checkTypeReport(object){
			if(object.is(':checked')){
					switch(parseInt(object.val())){
						case 1:
							object.parent().parent().parent().find('input[name="target[]"]').attr('readonly','readonly');
							object.parent().parent().parent().find('input[name="avoided[]"]').attr('readonly','readonly');							
						break;
						case 2:
							object.parent().parent().parent().find('input[name="target[]"]').removeAttr('readonly','readonly');
							object.parent().parent().parent().find('input[name="avoided[]"]').removeAttr('readonly','readonly');
						break;
					}
					updateShoppingCartTable(1);
				}
		}
        
        function checkExclusive(){
			updateShoppingCartTable(1);
		}
       
		function updateShoppingCartTable(type){
			_errorReport = 0;
			_indexObject = 0;
			_errorMessage="";
			if(type==2){
				jQuery('.elementClaim').each(function(index){
					if(jQuery(this).find('.tpExclusive').is(':checked')===false){
						_errorReport = 1;
						_indexObject = index;
						_errorMessage ="Please check report should to be made Exclusive for you , or Available for others too.";
						return false;
					}
					if(jQuery(this).find('.tpReport').is(':checked')===false){
						_errorReport = 1;
						_indexObject = index;
						_errorMessage ="Please select type of report PriorArt Or ClaimChart.";
						return false;
					}
					if(jQuery(this).find('input[name="patent[]"]').val()==""){
						_errorReport = 1;
						_indexObject = index;
						_errorMessage ="Please enter Patent Number.";
						return false;
					}
					if(jQuery(this).find('input[name="claim[]"]').val()==""){
						_errorReport = 1;
						_indexObject = index;
						_errorMessage ="Please enter Claim number.";
						return false;
					}
				});
			}
			
			if(_errorReport == 0){
				jQuery('.elementClaim').removeClass('alert-error');
				_claimChartExclusive = 0;
				_claimChartNonExclusive = 0;
				_priorArtNonExclusive = 0;
				_priorArtExclusive = 0;
				jQuery('.elementClaim').each(function(index){
					switch(parseInt(jQuery(this).find('input[name="type_report'+index+'"]:checked').val())){
						case 1:
							/*PriorArt*/
							switch(parseInt(jQuery(this).find('input[name="check_exclusive_multiple'+index+'"]:checked').val())){
								case 1:
									/*Exclusive*/
									_priorArtExclusive = _priorArtExclusive + 1;
								break;
								case 2:
									/*Non Exclusive*/
									_priorArtNonExclusive = _priorArtNonExclusive +1;
								break;
							}
						break;
						case 2:
							/*ClaimChart*/
							switch(parseInt(jQuery(this).find('input[name="check_exclusive_multiple'+index+'"]:checked').val())){
								case 1:
									/*Exclusive*/
									_claimChartExclusive = _claimChartExclusive + 1;
								break;
								case 2:
									/*Non Exclusive*/
									_claimChartNonExclusive = _claimChartNonExclusive + 1;
								break;
							}
						break;
					}
				});
				jQuery('.ccNon').html((_claimChartNonExclusive>0)?_claimChartNonExclusive:'-');
				jQuery('.ccExc').html((_claimChartExclusive>0)?_claimChartExclusive:'-');
				jQuery('.panon').html((_priorArtNonExclusive>0)?_priorArtNonExclusive:'-');
				jQuery('.paExc').html((_priorArtExclusive>0)?_priorArtExclusive:'-');
				_total = 0;
				if(_claimChartNonExclusive>0){
					_ss = _claimChartNonExclusive * 500;
					_total = _total + _ss;
					jQuery('.ccNonSub').html('$'+_ss);
				} else {
					jQuery('.ccNonSub').html('-');
				}
				if(_claimChartExclusive>0){
					_ss = _claimChartExclusive * 700;
					_total = _total + _ss;
					jQuery('.ccSub').html('$'+_ss);
				} else {
					jQuery('.ccSub').html('-');
				}
				if(_priorArtNonExclusive>0){
					_ss = _priorArtNonExclusive * 800;
					_total = _total + _ss;
					jQuery('.paNonSub').html('$'+_ss);
				} else {
					jQuery('.paNonSub').html('-');
				}
				if(_priorArtExclusive>0){
					_ss = _priorArtExclusive * 1200;
					_total = _total + _ss;
					jQuery('.paSub').html('$'+_ss);
				} else {
					jQuery('.paSub').html('-');
				}
				/*Grand Total*/
				if(_total>0){
					jQuery('.grandTotal').html('$'+_total);
				} else {
					jQuery('.grandTotal').html('-');
				}
				return true;
			} else {
				alert(_errorMessage);
				jQuery("#patentImplementedAll>div.elementClaim").eq(_indexObject).addClass('alert-error');	
				return false;			
			}
		}
			function implementedSkelton(object){
				if(updateShoppingCartTable()){
					jQuery('.btnAddSpan').css('display','none');
					_length = jQuery("#patentImplementedAll>div.elementClaim").length;
					jQuery("#patentImplementedAll").append('<div class="elementClaim  pull-left tM"><div class="span12 dP "><div class="span2"><input class="input-block-level" maxlength="10" name="patent[]" type="text" placeholder="Enter Patent Number"></div><div class="span2"><input class="input-block-level" maxlength="3" name="claim[]" type="text" placeholder="Enter a Claim Number"></div><div class="span7" style="padding-top:5px;"><label style="display:inline-block">Select whether their report should to be made &nbsp; </label><label class="radio inline" style="padding-top: 0px; margin-top: -3px;"><input type="radio" onclick="checkExclusive();" id="check_exclusive_multiple" class="tpExclusive" name="check_exclusive_multiple'+_length+'" value="1"> Exclusive for you</label><label style="display:inline-block">, or &nbsp;</label><label class="radio inline" style="padding-top: 0px; margin-top: -3px;"><input type="radio" id="check_exclusive_multiple" onclick="checkExclusive();" class="tpExclusive" name="check_exclusive_multiple'+_length+'" value="2"> Available for others too.</label></div><div class="span1 btnDeleteSpan " ><a class="btn btn-flat" href="javascript://" onclick="deleteSkelton(jQuery(this));">Remove</a></div></div><div class="span12 noMargin"><div class="span2"><label class="radio inline noMargin"><input type="radio" id="type_report" onclick="checkTypeReport(jQuery(this))" class="tpReport" name="type_report'+_length+'" value="1"> PriorArt Report</label></div><div class="span2"><label class="radio inline noMargin"><input type="radio" id="type_report" class="tpReport" onclick="checkTypeReport(jQuery(this))" name="type_report'+_length+'" value="2"> ClaimChart Report</label></div><div class="span3"><input class="input-block-level" name="target[]" type="text"  placeholder="products/companies to target (optional)"></div><div class="span3"><input class="input-block-level" name="avoided[]" type="text" placeholder="products/companies to ignore (optional)"></div><div class="span2 btnAddSpan"><a class="btn btn-flat pull-right" href="javascript://" onclick="implementedSkelton(jQuery(this));">Add a Claim</a></div></div></div>');
					var destination = object.offset().top;
					jQuery("html:not(:animated),body:not(:animated)").animate({ scrollTop: destination+101}, 1100);
				}
				
			} 

            function refreshCaptcha() {
                jQuery("#order_captcha").empty().html('<img src="' + __SiteURL + 'index.php?option=com_survey&format=&task=customer.getCaptcha"/>');
            }
			
			function deleteSkelton(object){
				if(jQuery('.btnDeleteSpan').length>1){
					object.parent().parent().parent().remove();
					var destination = object.offset().top;
					jQuery("#patentImplementedAll>div.elementClaim").eq(jQuery("#patentImplementedAll>div.elementClaim").length-1).find('.btnAddSpan').css('display','block');
					jQuery("#patentImplementedAll>div.elementClaim").eq(jQuery("#patentImplementedAll>div.elementClaim").length-1).find('.btnDeleteSpan').css('display','block');
					updateShoppingCartTable();
					jQuery('.elementClaim').each(function(index){
						jQuery(this).find('div.dP').find('input[type="radio"]').eq(0).attr('name','check_exclusive_multiple'+index);
						jQuery(this).find('div.dP').find('input[type="radio"]').eq(1).attr('name','check_exclusive_multiple'+index);
						jQuery(this).find('div.noMargin').find('input[type="radio"]').eq(0).attr('name','type_report'+index);
						jQuery(this).find('div.noMargin').find('input[type="radio"]').eq(1).attr('name','type_report'+index);
					});
				} else {
					alert('You cannot remove it.');
				}
			}
			
            jQuery(document).ready(function() {
                jQuery("#project_deadline_multiple").datepicker({dateFormat: 'yy-mm-dd'});
                jQuery("#patent_number_find").focus(function() {
                    jQuery("#project_nane_find").val('');
                });
                jQuery("#project_nane_find").focus(function() {
                    jQuery("#patent_number_find").val('');
                });
                /*var handsontable1 = $container1.data('handsontable');*/
                jQuery("#project_name_multiple").focus(function() {
                    jQuery("#project_name").val('');
                    jQuery("#patent_number").val('');
                    jQuery("#claim_number").val('');
                    jQuery("#check_exclusive").val('');
                    if (jQuery("#check_exclusive").is(':checked')) {
                        jQuery("#check_exclusive").removeAttr('checked');
                    }
                });
                jQuery("#multiple_pay").click(function() {
                    if (jQuery("#project_name_multiple").val() == "") {
                        alert('Please enter project name.');
                        return false;
                    } else {
                        if (jQuery("#project_name_multiple").val().length > 7) {
                            alert('Project length should not be more than 7 character.');
                            return false;
                        }
                    }
                    if (jQuery("#project_deadline_multiple").val() == "") {
                        alert('Please enter deadline date.');
                        return false;
                    }
                    if (jQuery("#comment").val() == "") {
                        alert('Please enter comment for this claim.');
                        return false;
                    }
                    __E = 0;
                    if (jQuery("#check_exclusive_multiple").is(':checked')) {
                        __E = jQuery("#check_exclusive_multiple").val();
                    }
                    __THIS = jQuery(this);
                    __THIS.attr('disabled', true);
                    __DataExcel1 = [];
                    
                    if(jQuery('input[name="patent[]"]').length>0){					
						for(i=0;i<jQuery('input[name="patent[]"]').length;i++){
							_innserAe = new Array(jQuery('input[name="patent[]"]').eq(i).val(),jQuery('input[name="claim[]"]').eq(i).val(),jQuery('input[name="target[]"]').eq(i).val(),jQuery('input[name="avoided[]"]').eq(i).val());
							__DataExcel1.push(_innserAe);
						}
					}
                    if (__DataExcel1.length > 0) {
                        _FLAG = 0;
                        for (e = 0; e < __DataExcel1.length; e++) {
                            if (__DataExcel1[e][0].length > 0) {
                                _FLAG = 1;
                                if (__DataExcel1[e][0].length < 7 && __DataExcel1[e][0].length > 9) {

                                    alert('Please enter Patent Number either start US letter and character length should be 9 OR Character length should be 7 without US');
                                    __THIS.removeAttr('disabled');
                                    return false;
                                } else {
                                    if (__DataExcel1[e][0].length == 9) {
                                        _STR = __DataExcel1[e][0];
                                        _STRING = _STR.substring(0, 2);
                                        if (_STRING.toUpperCase() != 'US') {
                                            alert('Please enter Patent Number either start US letter and character length should be 9 OR Character length should be 7 without US');
                                            __THIS.removeAttr('disabled');
                                            return false;
                                        }
                                    } else if (__DataExcel1[e][0].length == 7) {

                                        _STR = __DataExcel1[e][0];
                                        _STRING = _STR.substring(0, 2);
                                        if (_STRING.toUpperCase() == 'US') {
                                            alert('Please enter Patent Number either start US letter and character length should be 9 OR Character length should be 7 without US');
                                            __THIS.removeAttr('disabled');
                                            return false;
                                        }
                                    } else {

                                        alert('Please enter Patent Number either start US letter and character length should be 9 OR Character length should be 7 without US');
                                        __THIS.removeAttr('disabled');
                                        return false;
                                    }
                                }
                            }
                            if (__DataExcel1[e][1].length > 0) {
                                if (__DataExcel1[e][1].length > 2) {
                                    alert('Claim number should be 2 characters.');
                                    __THIS.removeAttr('disabled');
                                    return false;
                                }
                            }
                        }
                        if (_FLAG == 0) {

                            alert('Please enter Patent number and Claim number.');
                            __THIS.removeAttr('disabled');
                            return false;
                        }
                    } else {

                        alert('Please enter Patent number and Claim number.');
                        __THIS.removeAttr('disabled');
                        return false;
                    }
                    
                    
                   
					
                    jQuery.ajax({
                        url: __SiteURL + 'index.php?option=com_survey&task=customer.projectSurveyQuestionMultiple',
                        type: 'POST',
                        dataType: 'json',
                        data: {p: jQuery("#project_name_multiple").val(), e: __E, captach_code: jQuery('#captach_code').val(), other:__DataExcel1 , d: jQuery("#project_deadline_multiple").val(), c: jQuery("#comment").val(), format: ''},
                        success: function(res) {
                            __THIS.removeAttr('disabled');
                            __DATA = res;
                            if (__DATA.id > 0) {
                                __ram = __DATA.id;
                                __amTT = __DATA.amt;
                                _amt = 0.5;
                                _number_of_patent = __DATA.number_of_patent;
                                jQuery("#no_of_assets").html(__DATA.number_of_patent);
                                jQuery("#total_price").html(__amTT);
                                __PPURLForA = __PPURLForA + "&lc=US&item_name=Order Of ClaimCharts&desc=dummy&quantity=" + _number_of_patent + "&amount=" + __amTT + "&currency_code=USD&item_number=" + __ram + "&notify_url=<?php echo urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderNotify&raw='); ?>" + __ram + "&return=<?php echo urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderSuccess&raw='); ?>" + __ram + "&cancel=<?php echo urlencode(JUri::base() . 'index.php?option=com_survey&task=customer.orderCancel&raw='); ?>" + __ram;
                                window.location.href = __PPURLForA;
                            } else {
                                alert(__DATA.error);
                            }
                        }
                    });
                });
            });

    </script>
</div>
