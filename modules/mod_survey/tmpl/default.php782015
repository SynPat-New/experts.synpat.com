    <script>		
        __DataExcel1 = '';
        __SiteURL = '<?php echo JUri::base() ?>';
        __PPURLForA = '<?php echo $paypalURL; ?>&business=<?php echo $paypalEmail; ?>'; 
       
		function applyCoupon(){
			if(jQuery("#coupon_code").val()!=""){
				if(updateShoppingCartTable(2)){
					jQuery.ajax({
						type:'POST',
						url:'<?php echo JUri::base();?>',
						data:{option:'com_survey',task:'survey.apply_coupon',cou:jQuery("#coupon_code").val(),format:''},
						cache:false,
						success:function(data){
							_data = jQuery.parseJSON(data);
							if(typeOf(_data.error)!='number'){
								_amt = jQuery('.grandTotal').eq(0).text();
								_amt= _amt.substr(1);
								disc = (_amt*_data.discount)/100;
								newAmt = _amt - disc;
								jQuery('.finalAmount').remove();
								jQuery('.reportTotal').parent().parent().append("<tr class='finalAmount' style='border:1px solid #DDDDDD'><td style='text-align:left;'>Final Amount</td><td class='aCenter'></td><td class='aCenter'></td><td class='aCenter' style='font-weight:bold;'>$"+parseFloat(newAmt).toFixed(2)+"</td></tr>");
							} else{
								alert("Invalid coupon!");
							}
						}
					});
				}
			} else {
				alert("Enter coupon code");
			}			
		}
		
		function changeElement(object){
			/*PriorArt || ClaimChart*//*Patent || Published || Unpublished*//*Exclusive for you || Available for others*/	
			__index = object.parent().parent().parent().index();	
			if(__index>0){
				object.parent().parent().parent().find('div.nextButton').html("<div class='span12 btnDeleteSpan'><a class='btn btn-flat pull-right' href='javascript://' onclick='deleteSkelton(jQuery(this));'>Remove</a></div><div class='span12 btnAddSpan noMargin'><a class='btn btn-flat pull-right' href='javascript://' onclick='implementedSkelton(jQuery(this));'>Add Claim</a></div><div class='span12  noMargin fileEvidence' style='display:none;'><input type='file' multiple name='upload_evidence_"+__index+"[]' style='font-size: 12px;' class='span12 file'/></div>");	
			}
			switch(parseInt(object.parent().parent().find('select[name="type_of_report[]"]').val())){
				case 1:	
					if(object.attr('name')=='type_of_report[]'){
						object.parent().parent().find('select[name="type_of_document[]"]').html('<option value="0">Type of Document</option><option value="1">Patent</option><option value="2">Published Application</option><option value="3">Unpublished Application</option>');
					}
					switch(parseInt(object.parent().parent().find('select[name="type_of_document[]"]').val())){
						case 1:
							/*Patent*/
							object.parent().parent().parent().find('div.nextElement').removeClass('span8').addClass('span2').html('<div class="span12"><div class="controls"><input class="input-block-level patent" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Patent Number" maxlength="10" name="patent'+__index+'" type="text" placeholder="Enter Patent Number"></div></div><div class="span12 noMarginLeft"><div class="controls"><input class="input-block-level minimum" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please state here the minimum dollar amount you would be willing to pay for one report, as it would allow PeXperts to adjust the time and efforts they invest in your order." maxlength="10" onkeypress="return isNumber(event)" name="minimum_price_claim'+__index+'" type="text" placeholder="Minimum Price/Claim"></div></div><div class="span12 noMarginLeft"><input class="input-block-level claim" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Enter a Claim Number" maxlength="3" name="claim'+__index+'" type="text" placeholder="Enter a Claim Number"></div>');object.parent().parent().parent().find('div.nextElement1').css('display','block').addClass('span6').html('<div class="span4"><input class="input-block-level datepublished" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Latest evidence date" name="target'+__index+'" type="text" placeholder="Latest evidence date"></div><div class="span12 noMarginLeft"><textarea class="span12" style="resize:none;min-height:71px" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please provide comments for claim" name="claim_comment'+__index+'" type="text" placeholder="Please provide comments for claim"></textarea></div>');
							enableDate();
							addToolTip();
							object.parent().parent().parent().find('div.fileEvidence').css('display','');
						break;
						case 2:
							/*Published*/
							object.parent().parent().parent().find('div.nextElement').removeClass('span8').addClass('span2').html('<div class="span12"><input class="input-block-level application" maxlength="20" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Application Number" name="application'+__index+'" type="text" placeholder="Enter Application Number"></div><div class="span12 noMarginLeft"><input class="input-block-level datepublished" maxlength="20" name="published_date'+__index+'" type="text" placeholder="Published on or before" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please enter the latest publication date for the prior art to be searched."></div><div class="span12 noMarginLeft"><div class="controls"><input class="input-block-level minimum" maxlength="10" name="minimum_price_claim'+__index+'" type="text" onkeypress="return isNumber(event)" placeholder="Minimum Price/Claim" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please state here the minimum dollar amount you would be willing to pay for one report, as it would allow PeXperts to adjust the time and efforts they invest in your order."></div></div>');object.parent().parent().parent().find('div.nextElement1').css('display','block').addClass('span6').html('<div class="span4"><input class="input-block-level claim" maxlength="3" name="claim'+__index+'" type="text" placeholder="Enter a Claim Number" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Claim Number"></div><div class="span12 noMarginLeft"><textarea class="span12" style="resize:none;min-height:71px" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please provide comments for claim" name="claim_comment'+__index+'" type="text" placeholder="Please provide comments for claim"></textarea></div>');
							enableDate();addToolTip();
							object.parent().parent().parent().find('div.fileEvidence').css('display','');
						break;
						case 3:
							/*Unpublished*/
							object.parent().parent().parent().find('div.nextElement').removeClass('span8').addClass('span2').html('<div class="span12"><input class="input-block-level datepublished" maxlength="20" data-placement="top" data-rel="tooltip" data-original-title="Please enter the latest publication date for the prior art to be searched." data-trigger="manual" required="required" name="published_date'+__index+'" type="text" placeholder="Published on or before"></div><div class="span12 noMarginLeft"><div class="controls"><input class="input-block-level minimum" maxlength="10" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please state here the minimum dollar amount you would be willing to pay for one report, as it would allow PeXperts to adjust the time and efforts they invest in your order." onkeypress="return isNumber(event)" name="minimum_price_claim'+__index+'" type="text" placeholder="Minimum Price/Claim"></div></div>');object.parent().parent().parent().find('div.nextElement1').css('display','block').addClass('span6').html('<div class="span12 noMarginLeft"><textarea style="height:50px;" name="claim_language'+__index+'" class="claim_language span12" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Since the application is not published yet, you have to provide the language." placeholder="Enter the claim language"></textarea></div><div class="span12 noMarginLeft"><textarea class="span12 " style="resize:none;min-height:50px" data-placement="top" data-trigger="manual" data-rel="tooltip" data-original-title="Please provide comments for claim" name="claim_comment'+__index+'" type="text" placeholder="Please provide comments for claim"></textarea></div>');
							enableDate();addToolTip();
							object.parent().parent().parent().find('div.fileEvidence').css('display','');							
						break;
						default:
							/*Remove Everything*/
							object.parent().parent().parent().find('div.nextElement').html('');
							object.parent().parent().parent().find('div.nextElement1').html('');
							//object.parent().parent().find('div.nextButton').html('');
						break;
					}
				break;
				case 2:
					if(object.attr('name')=='type_of_report[]'){
						object.parent().parent().find('select[name="type_of_document[]"]').html('<option value="0">Type of Document</option><option value="1">Patent</option>');
					}
					switch(parseInt(object.parent().parent().find('select[name="type_of_document[]"]').val())){
						case 1:
							/*Patent*/
							object.parent().parent().parent().find('div.nextElement').removeClass('span8').addClass('span2').html('<div class="span12"><input class="input-block-level patent" maxlength="10" data-placement="top" data-trigger="manual" data-rel="tooltip" data-original-title="Patent Number" name="patent'+__index+'" type="text" placeholder="Enter Patent Number"></div><div class="span12 noMarginLeft"><input class="input-block-level minimum" onkeypress="return isNumber(event)" maxlength="10" name="minimum_price_claim'+__index+'" type="text" placeholder="Minimum Price/Claim" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please state here the minimum dollar amount you would be willing to pay for one report, as it would allow PeXperts to adjust the time and efforts they invest in your order."></div><div class="span12 noMarginLeft" ><input class="input-block-level claim" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Claim Number" maxlength="3" name="claim'+__index+'" type="text" placeholder="Enter a Claim Number"></div>');
							object.parent().parent().parent().find('div.nextElement1').css('display','block').addClass('span6').html('<div class="span12 noMarginLeft"><input class="input-block-level target" name="target'+__index+'" type="text" placeholder="List the target products and /or companies to research (Optional)"></div><div class="span12 noMarginLeft"><input class="input-block-level avoided" name="avoided'+__index+'" type="text" placeholder="List the target products and /or companies you wish the expert not to research (Optional)"></div><div class="span12 noMarginLeft"><textarea class="span12 " style="resize:none;min-height:30px;height:30px" data-placement="top" data-rel="tooltip" data-trigger="manual" data-original-title="Please provide comments for claim"  name="claim_comment'+__index+'" type="text" placeholder="Please provide comments for claim"></textarea></div>');addToolTip();	
							object.parent().parent().parent().find('div.fileEvidence').css('display','');
						break;
						case 2:
						case 3:
						default:
							/*Remove Everything*/
							object.parent().parent().parent().find('div.nextElement').html('');
							object.parent().parent().parent().find('div.nextElement1').html('');
							//object.parent().parent().find('div.nextButton').html('');
						break;
					}
				break;
				default:
					/*Remove Everything*/
					object.parent().parent().parent().find('div.nextElement').html('');
					object.parent().parent().parent().find('div.nextElement1').html('');
					//object.parent().parent().find('div.nextButton').html('');					
				break;
			}
			updateShoppingCartTable(1);
		}
		
		
        function checkExclusive(){
			updateShoppingCartTable(1);
		}
       
		function updateShoppingCartTable(type){
			_errorReport = 0;
			_indexObject = 0;
			_errorMessage="";
			if(type==2){
				jQuery('.elementClaim').each(function(index){
					_indexObject = index;
					if(jQuery(this).find('select[name="type_of_report[]"]').val()=='0'){
						_errorReport = 1;
						_errorMessage ="Please select type of report.";
						return false;
					}
					if(jQuery(this).find('select[name="type_of_document[]"]').val()=='0'){
						_errorReport = 1;
						_errorMessage ="Please select type of document.";
						return false;
					}
					if(jQuery(this).find('select[name="type_of_exclusivity[]"]').val()=='0'){
						_errorReport = 1;
						_errorMessage ="Please select exclusivity.";
						return false;
					}
					switch(parseInt(jQuery(this).find('select[name="type_of_report[]"]').val())){
						case 1:
							/*PriorArt*/
							switch(parseInt(jQuery(this).find('select[name="type_of_document[]"]').val())){
								case 1:
									/*Patent*/
									if(jQuery(this).find('input.patent').val()==""){
										_errorReport = 1;
										_errorMessage ="Please enter patent number.";
										return false;
									}
									if(jQuery(this).find('input.claim').val()==""){
										_errorReport = 1;
										_errorMessage ="Please enter claim number.";
										return false;
									}
								break;
								case 2:
									/*Published*/
									if(jQuery(this).find('input.application').val()==""){
										_errorReport = 1;
										_errorMessage ="Please enter application number.";
										return false;
									}
									if(jQuery(this).find('input.claim').val()==""){
										_errorReport = 1;
										_errorMessage ="Please enter claim number.";
										return false;
									}
								break;
								case 3:
									/*Unpublished*/
									if(jQuery(this).find('textarea.claim_language').val()==""){
										_errorReport = 1;
										_errorMessage ="Please enter claim language.";
										return false;
									}
								break;								
							}
						break;
						case 2:
							/*ClaimChart*/
							switch(parseInt(jQuery(this).find('select[name="type_of_document[]"]').val())){
								case 1:
									/*Patent*/
									if(jQuery(this).find('input.patent').val()==""){
										_errorReport = 1;
										_errorMessage ="Please enter patent number.";
										return false;
									}
									if(jQuery(this).find('input.claim').val()==""){
										_errorReport = 1;
										_errorMessage ="Please enter claim number.";
										return false;
									}
								break;
								case 2:
								case 3:
								default:
									_errorReport = 1;
									_errorMessage ="Please select other document type in ClaimChart report.";
									return false;
								break;
							}
						break;
					}
				});
			}
			
			if(_errorReport == 0){
				jQuery('.elementClaim').removeClass('alert-error');
				_claimChartExclusive = 0;
				_claimChartNonExclusive = 0;
				_priorArtNonExclusive = 0;
				_priorArtExclusive = 0;
				jQuery('.elementClaim').each(function(index){
					switch(parseInt(jQuery(this).find('select[name="type_of_report[]"]').val())){
						case 1:
							/*PriorArt*/
							switch(parseInt(jQuery(this).find('select[name="type_of_exclusivity[]"]').val())){
								case 1:
									/*Exclusive*/
									_priorArtExclusive = _priorArtExclusive + 1;
								break;
								case 2:
									/*Non Exclusive*/
									_priorArtNonExclusive = _priorArtNonExclusive +1;
								break;
							}
						break;
						case 2:
							/*ClaimChart*/
							switch(parseInt(jQuery(this).find('select[name="type_of_exclusivity[]"]').val())){
								case 1:
									/*Exclusive*/
									if(parseInt(jQuery(this).find('select[name="type_of_document[]"]').val())==1){
										_claimChartExclusive = _claimChartExclusive + 1;
									}
								break;
								case 2:
									/*Non Exclusive*/
									if(parseInt(jQuery(this).find('select[name="type_of_document[]"]').val())==1){
										_claimChartNonExclusive = _claimChartNonExclusive + 1;
									}
								break;
							}
						break;
					}
				});
				
				jQuery('.ccNon').html((_claimChartNonExclusive>0)?_claimChartNonExclusive:'-');
				jQuery('.ccExc').html((_claimChartExclusive>0)?_claimChartExclusive:'-');
				jQuery('.panon').html((_priorArtNonExclusive>0)?_priorArtNonExclusive:'-');
				jQuery('.paExc').html((_priorArtExclusive>0)?_priorArtExclusive:'-');
				_total = 0;
				if(_claimChartNonExclusive>0){
					_ss = _claimChartNonExclusive * 400;
					_total = _total + _ss;
					jQuery('.ccNonSub').html('$'+_ss);
				} else {
					jQuery('.ccNonSub').html('-');
				}
				if(_claimChartExclusive>0){
					_ss = _claimChartExclusive * 700;
					_total = _total + _ss;
					jQuery('.ccSub').html('$'+_ss);
				} else {
					jQuery('.ccSub').html('-');
				}
				if(_priorArtNonExclusive>0){
					_ss = _priorArtNonExclusive * 700;
					_total = _total + _ss;
					jQuery('.paNonSub').html('$'+_ss);
				} else {
					jQuery('.paNonSub').html('-');
				}
				if(_priorArtExclusive>0){
					_ss = _priorArtExclusive * 900;
					_total = _total + _ss;
					jQuery('.paSub').html('$'+_ss);
				} else {
					jQuery('.paSub').html('-');
				}
				/*Grand Total*/
				if(_total>0){
					jQuery('.grandTotal').html('$'+_total);
					jQuery('.reportTotal').html(_claimChartNonExclusive + _claimChartExclusive + _priorArtNonExclusive + _priorArtExclusive);
				} else {
					jQuery('.grandTotal').html('-');
					jQuery('.reportTotal').html('-');
				}
				return true;
			} else {
				alert(_errorMessage);
				jQuery("#patentImplementedAll>div.elementClaim").eq(_indexObject).addClass('alert-error');	
				return false;			
			}			
		}
			function implementedSkelton(object){ 
				if(updateShoppingCartTable(1)){
					jQuery('.btnAddSpan').css('display','none');
					jQuery('.btnDeleteSpan').css('display','block');
					_length = jQuery("#patentImplementedAll>div.elementClaim").length;
					jQuery("#patentImplementedAll").append('<div id="patentImplementedChild'+_length+'" class="elementClaim row" style="margin-left: 0px; padding:10px;"><div class="span2"><div class="span12 noMarginLeft"><select name="type_of_report[]"  data-rel="tooltip" data-original-title="Each box is dedicated for one claim, in which you may order either a PriorArt Report or a ClaimChart Report. Both reports pretty much look the same, but for one main difference - the publication date of the evidence provided by the PeXperts. In PriorArt Repots the evidence must precede the filing date of the patent application, while in ClaimChart Reports it\'\s the opposite."  class="span12" onchange="changeElement(jQuery(this))"><option value="0">Type of Report</option><option value="1">PriorArt Report</option><option value="2">ClaimChart Report</option></select></div><div class="span12 noMarginLeft"><select name="type_of_document[]" data-placement="top" data-rel="tooltip" data-original-title="You may order a ClaimChart report only for issued patents, while PriorArt reports can be ordered not only for issued patents (to find prior art that the patent examiner overlooked so that a patent can be declared invalid), but also for patent applications (helps to determine whether the invention is novel before committing the resources necessary to obtain a patent)." class="span12" onchange="changeElement(jQuery(this))"><option value="0">Type of Document</option><option value="1">Patent</option><option value="2">Published Application</option><option value="3">Unpublished Application</option></select></div><div class="span12 noMarginLeft"><select data-placement="top" data-rel="tooltip" data-original-title="You may ask that the reports for this claim will not be sold to others but you, or, you may allow ClaimCharts.info to offer the reports for sale to others as well. Knowing about the potential to sell to others, PeXperts might lower their asking price for their reports." name="type_of_exclusivity[]" class="span12" onchange="checkExclusive()"><option value="0">Exclusivity</option><option value="1">Exclusively made for you</option><option value="2">Available for others</option></select></div></div><div class="span2 nextElement"></div><div class="span6 nextElement1"></div><div class="span2 nextButton"><div class="span12 btnDeleteSpan" style="display:none"><a class="btn btn-flat pull-right" href="javascript://" onclick="deleteSkelton(jQuery(this));">Remove</a></div><div class="span12 btnAddSpan noMargin"><a class="btn btn-flat pull-right" href="javascript://" onclick="implementedSkelton(jQuery(this));">Add Claim</a></div></div></div>'); 
					var destination = jQuery("#patentImplementedChild"+_length).offset().top;
					jQuery("html:not(:animated),body:not(:animated)").animate({ scrollTop: destination-40}, 1100);
					addToolTip();
				}				
			} 

            function refreshCaptcha() {
                jQuery("#order_captcha").empty().html('<img src="' + __SiteURL + 'index.php?option=com_survey&format=&task=customer.getCaptcha"/>');
            }
			
			function deleteSkelton(object){
				if(jQuery('.btnDeleteSpan').length>1){
					object.parent().parent().parent().remove();
					var destination = object.offset().top;
					jQuery("#patentImplementedAll>div.elementClaim").eq(jQuery("#patentImplementedAll>div.elementClaim").length-1).find('.btnAddSpan').css('display','block');
					jQuery("#patentImplementedAll>div.elementClaim").eq(jQuery("#patentImplementedAll>div.elementClaim").length-1).find('.btnDeleteSpan').css('display','block');
					updateShoppingCartTable(1);
					jQuery('.elementClaim').each(function(index){
						if(jQuery(this).find('input.patent').length>0){
							jQuery(this).find('input.patent').attr('name','patent'+index);
						}
						if(jQuery(this).find('input.claim').length>0){
							jQuery(this).find('input.claim').attr('name','claim'+index);
						}
						if(jQuery(this).find('input.application').length>0){
							jQuery(this).find('input.application').attr('name','application'+index);
						}
						if(jQuery(this).find('textarea.claim_language').length>0){
							jQuery(this).find('textarea.claim_language').attr('name','claim_language'+index);
						}
						if(jQuery(this).find('input.target').length>0){
							jQuery(this).find('input.target').attr('name','target'+index);
						}
						if(jQuery(this).find('input.avoided').length>0){
							jQuery(this).find('input.avoided').attr('name','avoided'+index);
						}
						if(jQuery(this).find('input.file').length>0){
							jQuery(this).find('input.file').attr('name','upload_evidence_'+index+'[]');
						}
					});   
					if(jQuery('.btnDeleteSpan').length==1){
						jQuery('.btnDeleteSpan').css('display','none');
					}
					object.parent().parent().parent().find('div.fileEvidence').css('display','none');
				} else {
					alert('You cannot remove it.');
				}
			}
			
			function isNumber(evt) {
				evt = (evt) ? evt : window.event;
				var charCode = (evt.which) ? evt.which : evt.keyCode;
				if (charCode > 31 && (charCode < 48 || charCode > 57)) {
					return false;
				}
				return true;
			}
		
			function addToolTip(){
				/*jQuery('input,textarea,select').tooltip('hide');*/
				jQuery('input,textarea,select').mouseenter(function(){
					var that = jQuery(this);
					that.delay(4000).fadeIn(0).tooltip('show');
					/*setTimeout(function(){
						that.tooltip('hide');
					}, 2000);*/
				}).mouseleave(function(){
					jQuery(this).tooltip('hide');
				});
			}
			function enableDate(){
				jQuery(".datepublished").datepicker({dateFormat: 'yy-mm-dd'});				
				jQuery("#project_deadline_multiple").datepicker({dateFormat: 'yy-mm-dd'/*,minDate: '+1M'*/});				
			}
			jQuery(document).ready(function() {
                jQuery(".datepublished").datepicker({dateFormat: 'yy-mm-dd'});
                jQuery("#project_deadline_multiple").datepicker({dateFormat: 'yy-mm-dd'/*,minDate: '+1M'*/});
				jQuery('[data-rel="tooltip"]').mouseenter(function(){
					var that = jQuery(this);
					that.delay(5000).fadeIn(0).tooltip('show');
					/*setTimeout(function(){
						that.tooltip('hide');
					}, 2000);*/
				}).mouseleave(function(){
					jQuery(this).tooltip('hide');
				});
			});
    </script>
</div>
